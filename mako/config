# Mako notification daemon configuration with blur and SF Pro
# Save this as ~/.config/mako/config

# Global settings
font=SF Pro Display 11
markup=1
format=<b>%s</b>\n%b
sort=-time
layer=overlay
background-color=#1e1e1e80
text-color=#ffffff
width=380
height=120
border-size=1
border-color=#ffffff20
border-radius=12
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=1
margin=15
padding=20
anchor=top-right
max-visible=3
progress-color=#007aff

# Low urgency notifications
[urgency=low]
background-color=#1e1e1e60
text-color=#ffffff
border-color=#ffffff15
default-timeout=3000

# Normal urgency notifications  
[urgency=normal]
background-color=#1e1e1e80
text-color=#ffffff
border-color=#007aff40
default-timeout=5000

# Critical urgency notifications
[urgency=critical]
background-color=#ff3b3060
text-color=#ffffff
border-color=#ff3b30
default-timeout=0

# App-specific styling - macOS style colors
[app-name=notify-send]
border-color=#007aff60

[summary~=".*[Ee]rror.*"]
background-color=#ff3b3060
border-color=#ff3b30

[summary~=".*[Ss]uccess.*"]
background-color=#34c75960
text-color=#ffffff
border-color=#34c759

[summary~=".*[Ww]arning.*"]
background-color=#ff9f0a60
text-color=#ffffff
border-color=#ff9f0a
